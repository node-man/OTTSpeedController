{
  "manifest_version": 3,
  "name": "OTTSpeed — 배속·자막·번역",
  "description": "OTT 재생 속도 조절, 로컬 자막 표시와 A/B 비교, 문맥 번역 파일 교환",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "OTTSpeed · 배속·자막·번역"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["subtitles/core.js", "subtitles/controller.js", "scripts/content.js"],
      "run_at": "document_end"
    }
  ]
}
