{
  "manifest_version": 3,
  "name": "OTTDeck — 자막·번역·시청 도구",
  "description": "OTT 재생 설정, 자막 수집·번역과 작품별 라이브러리를 한곳에서 관리합니다.",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "OTTDeck · 자막·번역·시청 도구"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "subtitles/core.js",
        "subtitles/netflix.js",
        "subtitles/netflix-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "subtitles/core.js",
        "subtitles/netflix.js",
        "subtitles/capture-validation.js",
        "subtitles/netflix-capture.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "subtitles/core.js",
        "subtitles/controller.js",
        "scripts/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
